# APP
APP_ENV=dev
APP_PORT=8800
# Web interface (user app on /, administration on /admin): http://localhost:3000
FRONTEND_PORT=3000
CORS_ALLOW_ORIGINS=*
SENTRY_DSN=
IMAGE_VERSION=dev

# DATABASE (PostgreSQL) -- DATABASE_URL and REDIS_URL are built by docker compose
POSTGRES_DB=yimba
POSTGRES_USER=yimba
POSTGRES_PASSWORD=ChangeMe

# AUTHENTICATION: "local" accounts in the database (default), or "remote" for the legacy auth microservice.
AUTH_PROVIDER=local
# Signs the access tokens: at least 32 random characters, mandatory in production (openssl rand -base64 48).
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Public sign-up (POST /auth/register); admins can always create accounts (yimba user create).
REGISTRATION_ENABLED=true
# After this many wrong passwords in a row, the account refuses logins for LOGIN_LOCK_MINUTES.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Accepted password lengths, any characters (8 <= MIN <= MAX <= 1024).
MIN_PASSWORD_LENGTH=10
MAX_PASSWORD_LENGTH=128

# LEGACY AUTH MICROSERVICE (only with AUTH_PROVIDER=remote)
API_AUTH_URL_BASE=http://auth:9077
CHECK_USERINFO_URL=/check-validate-access-token
CHECK_ACCESS_URL=/check-access

# COLLECTION (official APIs only; leave credentials empty to disable a source, press via RSS needs no key)
NEWS_EXTRA_FEEDS=
# GDELT: worldwide press, no key; one request every 5 seconds per IP (the collector retries when throttled).
GDELT_ENABLED=true
# YouTube Data API v3 key (Google Cloud console). 10 000 units a day, about 106 per keyword collected.
YOUTUBE_API_KEY=
YOUTUBE_COMMENT_VIDEOS=5
# Bluesky account used to search posts, with an app password (not the account password).
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Meta app (Facebook Pages, Instagram hashtags): long-lived token, app secret if "Require App Secret" is on.
META_ACCESS_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
# Comma separated Page ids; their posts are kept when they mention a watch keyword.
FACEBOOK_PAGE_IDS=
FACEBOOK_COMMENT_POSTS=5
# Instagram professional account id used for hashtag search (30 distinct hashtags per 7 days).
INSTAGRAM_ACCOUNT_ID=
COLLECTION_LIMIT=50
# Raw provider payloads (personal data in clear) are deleted when not seen for this many days.
RAW_RETENTION_DAYS=30

# ANALYSIS: "lexicon" (baseline, no extra dependency) or "transformers" (worker image built with EXTRAS)
ANALYSIS_ENGINE=lexicon
ANALYSIS_MODEL=
# Worker image extras: "ml" (transformers + torch CPU) and "tracking" (MLflow client), e.g. EXTRAS=ml tracking (no quotes: Make would keep them).
# Only the worker gets them (image tagged "-ml", ~2 GB); api, beat and flower keep the small image (~400 MB).
EXTRAS=
# MLflow server for "yimba annotation evaluate" (docker compose --profile ml up -d).
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=yimba-analysis
# Salt used to hash author handles. Mandatory in production, never change it afterwards.
AUTHOR_HASH_SALT=ChangeMe

# ALERTS
ALERT_WINDOW_HOURS=24
ALERT_COOLDOWN_HOURS=6

# RESOURCES (docker compose). One Celery child by default; with transformers (EXTRAS) each child needs the model
# (weights shared, ~1.1 GB, plus ~150 MB per child). Keep WORKER_TORCH_THREADS x WORKER_CONCURRENCY ~ WORKER_CPUS.
WORKER_CONCURRENCY=1
WORKER_CPUS=2
WORKER_MEMORY_LIMIT=2g
WORKER_TORCH_THREADS=2
# dbt parallel queries in the analytics job.
DBT_THREADS=2

# OPERATIONS
# Flower (Celery web UI, docker compose --profile monitoring up -d, http://localhost:5555): "user:password",
# mandatory in production.
FLOWER_BASIC_AUTH=admin:ChangeMe
# GlitchTip (docker compose --profile observability up, http://localhost:8000), then set SENTRY_DSN above.
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DB_PASSWORD=ChangeMe
GLITCHTIP_DOMAIN=http://localhost:8000

# ANALYTICS (docker compose --profile analytics run --rm analytics): dbt marts + Pandera checks.
# Set to repeat the run (seconds) when started with "up -d analytics".
ANALYTICS_EVERY_SECONDS=
# DASHBOARDS (docker compose --profile dashboards up -d): Apache Superset, http://localhost:8088
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=
SUPERSET_ADMIN_EMAIL=admin@localhost
# Password of the read-only role superset_reader (analytics/sql/create_superset_reader.sql).
SUPERSET_READER_PASSWORD=
# ANNOTATION (docker compose --profile annotation up -d): Label Studio, http://localhost:8080
LABEL_STUDIO_USERNAME=admin@localhost
LABEL_STUDIO_PASSWORD=
