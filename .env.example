# APP
APP_ENV=dev
APP_PORT=8800
CORS_ALLOW_ORIGINS=*
SENTRY_DSN=
IMAGE_VERSION=dev

# DATABASE (PostgreSQL) -- DATABASE_URL and REDIS_URL are built by docker compose
POSTGRES_DB=yimba
POSTGRES_USER=yimba
POSTGRES_PASSWORD=ChangeMe

# AUTH MICROSERVICE
API_AUTH_URL_BASE=http://auth:9077
CHECK_USERINFO_URL=/check-validate-access-token
CHECK_ACCESS_URL=/check-access

# COLLECTION (official APIs only; leave credentials empty to disable a source, press via RSS needs no key)
NEWS_EXTRA_FEEDS=
# YouTube Data API v3 key (Google Cloud console). 10 000 units a day, about 106 per keyword collected.
YOUTUBE_API_KEY=
YOUTUBE_COMMENT_VIDEOS=5
# Bluesky account used to search posts, with an app password (not the account password).
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
COLLECTION_LIMIT=50

# ANALYSIS: "lexicon" (baseline, no extra dependency) or "transformers" (image built with EXTRAS=ml)
ANALYSIS_ENGINE=lexicon
ANALYSIS_MODEL=
# Salt used to hash author handles. Mandatory in production, never change it afterwards.
AUTHOR_HASH_SALT=ChangeMe

# ALERTS
ALERT_WINDOW_HOURS=24
ALERT_COOLDOWN_HOURS=6
