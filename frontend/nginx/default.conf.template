# Written to /etc/nginx/conf.d/default.conf at start: ${API_UPSTREAM} and ${NGINX_LOCAL_RESOLVERS} come from the
# environment (see the Dockerfile).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    absolute_redirect off;
    client_max_body_size 1m;

    gzip_static on;
    gzip on;
    gzip_proxied any;
    gzip_types application/json;

    # The API address is resolved at request time: nginx starts even if the API is not up yet, and follows it when
    # its container is recreated.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

    location /api/ {
        set $api http://${API_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # File names carry a hash of their content: cached for good.
    location ~ ^(/admin)?/_app/immutable/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Single-page apps: every route of an app is its 200.html, always checked for a newer version.
    location = /admin {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files /admin/200.html =404;
    }

    location /admin/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /admin/200.html;
    }

    location / {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /200.html;
    }
}
