{
	"name": "yimba-frontend",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.34.6",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev:user": "pnpm --filter @yimba/user dev",
		"dev:admin": "pnpm --filter @yimba/admin dev",
		"build": "pnpm --recursive --filter './apps/*' build",
		"check": "pnpm --recursive check",
		"test": "pnpm --recursive test",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"api:types": "pnpm --filter @yimba/api types"
	},
	"devDependencies": {
		"prettier": "catalog:",
		"prettier-plugin-svelte": "catalog:"
	}
}
